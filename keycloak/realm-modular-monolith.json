          },
          {
            "name": "Any Authenticated User Policy",
            "description": "Any user holding one of the application roles.",
            "type": "aggregate",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "applyPolicies": "[\"Basic Role Policy\",\"Staff Role Policy\",\"System Admin Role Policy\"]"
            }
          },
          {
            "name": "Users Self-Service Permission",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "resources": "[\"users\"]",
              "scopes": "[\"users:view-own\",\"users:update-own\"]",
              "applyPolicies": "[\"Any Authenticated User Policy\"]"
            }
          },
          {
