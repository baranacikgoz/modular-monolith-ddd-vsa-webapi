          },
          {
            "name": "Service Account Policy",
            "description": "Machine callers authenticating with client credentials.",
            "type": "client",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "clients": "[\"ci-integration\"]"
