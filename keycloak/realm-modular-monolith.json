            "ownerManagedAccess": false,
            "uris": [
              "/notifications/devices/*"
            ],
            "scopes": [
              {
                "name": "devices:update-own"
              }
            ]
          },
          {
            "name": "stores",
            "displayName": "Stores",
            "type": "urn:backend-api:resources:stores",
            "ownerManagedAccess": false,
            "uris": [
              "/v1/stores/*"
            ],
            "scopes": [
              {
                "name": "stores:create"
              },
              {
                "name": "stores:view"
              },
              {
                "name": "stores:search"
              },
              {
                "name": "stores:update"
              },
              {
                "name": "stores:delete"
              },
              {
                "name": "stores:create-own"
              },
              {
                "name": "stores:view-own"
              },
              {
                "name": "stores:update-own"
              },
              {
                "name": "stores:delete-own"
              }
            ]
          },
          {
            "name": "products",
            "displayName": "Products",
            "type": "urn:backend-api:resources:products",
            "ownerManagedAccess": false,
            "uris": [
              "/v1/products/*"
            ],
            "scopes": [
              {
                "name": "products:create"
              },
              {
                "name": "products:view"
              },
              {
                "name": "products:search"
              },
              {
                "name": "products:update"
              },
              {
                "name": "products:delete"
              },
              {
                "name": "products:create-own"
              },
              {
                "name": "products:view-own"
              },
              {
                "name": "products:update-own"
              },
              {
                "name": "products:delete-own"
              },
              {
                "name": "products:search-own"
              }
            ]
          },
          {
            "name": "product-templates",
            "displayName": "Product templates",
            "type": "urn:backend-api:resources:product-templates",
            "ownerManagedAccess": false,
            "uris": [
              "/v1/product-templates/*"
            ],
            "scopes": [
              {
                "name": "product-templates:create"
              },
              {
                "name": "product-templates:view"
              },
              {
                "name": "product-templates:search"
              },
              {
                "name": "product-templates:update"
              },
              {
                "name": "product-templates:delete"
              }
            ]
