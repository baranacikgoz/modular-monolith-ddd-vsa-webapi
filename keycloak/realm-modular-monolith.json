            "uris": [
              "/hangfire/*"
            ],
            "scopes": [
              {
                "name": "hangfire:manage"
              }
            ]
          }
        ],
        "policies": [
          {
            "name": "Basic Role Policy",
            "description": "Users holding the realm role 'basic'.",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "fetchRoles": "true",
              "roles": "[{\"id\":\"basic\",\"required\":false}]"
            }
          },
          {
            "name": "Staff Role Policy",
            "description": "Users holding the realm role 'staff'.",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "fetchRoles": "true",
              "roles": "[{\"id\":\"staff\",\"required\":false}]"
            }
          },
          {
            "name": "System Admin Role Policy",
            "description": "Users holding the realm role 'system-admin'.",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "fetchRoles": "true",
              "roles": "[{\"id\":\"system-admin\",\"required\":false}]"
