    {
      "clientId": "backend-trusted-login",
      "name": "Backend trusted login",
      "description": "Used only by the backend after it has verified a one-time code itself. Its direct grant flow identifies the user by username without a credential, so this secret is equivalent to every end user's password: vault only.",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "backend-trusted-login-dev-secret-change-me",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true,
      "authenticationFlowBindingOverrides": {
        "direct_grant": "a3f4c8e2-1b2d-4e5f-9a6b-7c8d9e0f1a2b"
      },
      "attributes": {
        "access.token.lifespan": "300",
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "backend-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "backend-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm roles as roles claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
