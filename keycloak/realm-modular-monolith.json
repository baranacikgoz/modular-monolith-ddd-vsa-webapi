{
  "id": "modular-monolith",
  "realm": "modular-monolith",
  "displayName": "Modular Monolith",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 10,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1209600,
  "ssoSessionMaxLifespan": 7776000,
  "clientSessionIdleTimeout": 0,
  "clientSessionMaxLifespan": 0,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "accessCodeLifespanUserAction": 300,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,
  "passwordPolicy": "length(12) and notUsername(undefined) and notEmail(undefined)",
  "defaultSignatureAlgorithm": "RS256",
  "roles": {
    "realm": [
      {
        "name": "basic",
        "description": "Mobile end users (phone + OTP login).",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "staff",
        "description": "Support and management users (email + password login).",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "system-admin",
        "description": "Full administrative access. Includes staff.",
        "composite": true,
        "clientRole": false,
        "composites": {
          "realm": [
            "staff"
          ]
        }
      }
    ]
  },
  "authenticationFlows": [
    {
      "id": "a3f4c8e2-1b2d-4e5f-9a6b-7c8d9e0f1a2b",
      "alias": "trusted-login",
      "description": "Direct grant flow for the backend after it verified an OTP itself: identifies the user by username only. Bound exclusively to the backend-trusted-login client.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "direct-grant-validate-username",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "backend-api",
      "name": "Backend API",
      "description": "Resource server. Email + password direct grant, service account for the Admin REST API, Authorization Services host.",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "backend-api-dev-secret-change-me",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "fullScopeAllowed": true,
      "attributes": {
        "access.token.lifespan": "300",
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "backend-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "backend-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm roles as roles claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "authorizationSettings": {
        "allowRemoteResourceManagement": false,
        "policyEnforcementMode": "ENFORCING",
        "decisionStrategy": "AFFIRMATIVE",
        "resources": [
          {
            "name": "users",
            "displayName": "Users",
            "type": "urn:backend-api:resources:users",
            "ownerManagedAccess": false,
            "uris": [
              "/users/*"
            ],
            "scopes": [
              {
                "name": "users:view"
              },
              {
                "name": "users:search"
              },
              {
                "name": "users:manage"
              },
              {
                "name": "users:view-own"
              },
              {
                "name": "users:update-own"
              }
            ]
          },
          {
            "name": "sessions",
            "displayName": "Sessions",
            "type": "urn:backend-api:resources:sessions",
            "ownerManagedAccess": false,
            "uris": [
              "/tokens/sessions/*",
              "/tokens/revoke"
            ],
            "scopes": [
              {
                "name": "sessions:view-own"
              },
              {
                "name": "sessions:revoke-own"
              }
            ]
          },
          {
            "name": "devices",
            "displayName": "Devices",
